# Joy Risers — copy this file to .env and fill in ONE key. Never commit a real .env.
# The app looks for .env here (./.env) first, then one folder up (../.env).
# Keys already exported in your shell also work.

# Course key: gpt-6-luna through Portkey (https://api.portkey.ai/v1). Used first if present.
PORTKEY_API_KEY=

# Fallback: your own OpenAI key (also calls gpt-6-luna). Used only if PORTKEY_API_KEY is empty.
OPENAI_API_KEY=

# Optional: which bundled dataset to load by default: full (nationwide) or test (small)
# JOY_DATASET=test
